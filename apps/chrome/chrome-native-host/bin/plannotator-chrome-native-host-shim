#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
BUNDLE="$SCRIPT_DIR/plannotator-chrome-native-host-bundle.js"

if [ ! -f "$BUNDLE" ]; then
  echo "Native host bundle not found: $BUNDLE" >&2
  exit 1
fi

BUN_BIN="${BUN_BIN:-}"
if [ -z "$BUN_BIN" ]; then
  if command -v bun >/dev/null 2>&1; then
    BUN_BIN="$(command -v bun)"
  elif [ -x "$HOME/.bun/bin/bun" ]; then
    BUN_BIN="$HOME/.bun/bin/bun"
  elif [ -x "/opt/homebrew/bin/bun" ]; then
    BUN_BIN="/opt/homebrew/bin/bun"
  elif [ -x "/usr/local/bin/bun" ]; then
    BUN_BIN="/usr/local/bin/bun"
  else
    echo "bun executable not found. Set BUN_BIN to the Bun executable path." >&2
    exit 127
  fi
fi

exec "$BUN_BIN" run "$BUNDLE"
