#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
HOST_DIR="$(dirname "$SCRIPT_DIR")"

if [ -z "${PLANNOTATOR_BIN:-}" ] && [ -x "$HOME/.local/bin/plannotator" ]; then
  export PLANNOTATOR_BIN="$HOME/.local/bin/plannotator"
fi

BUN_BIN="${BUN_BIN:-}"
if [ -z "$BUN_BIN" ]; then
  if command -v bun >/dev/null 2>&1; then
    BUN_BIN="$(command -v bun)"
  elif [ -x "$HOME/.bun/bin/bun" ]; then
    BUN_BIN="$HOME/.bun/bin/bun"
  elif [ -x "/opt/homebrew/bin/bun" ]; then
    BUN_BIN="/opt/homebrew/bin/bun"
  elif [ -x "/usr/local/bin/bun" ]; then
    BUN_BIN="/usr/local/bin/bun"
  else
    echo "bun executable not found. Set BUN_BIN to the Bun executable path." >&2
    exit 127
  fi
fi
export BUN_BIN

exec "$BUN_BIN" "$HOST_DIR/src/host.ts"
